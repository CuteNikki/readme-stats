# A classic token (github.com/settings/tokens) with read:user, plus repo so
# private contributions count. It's only ever sent to GitHub.
GITHUB_TOKEN=

# The accounts cards are drawn for, comma-separated, the first being the
# default. Anyone else gets a 403, so nobody else spends the token's limits.
GITHUB_USERS=

# How long GitHub's answers are kept before they're fetched again, in the
# background, in minutes
CACHE_MINUTES=30

# Where the view counter keeps its count, and the number it starts from
# (e.g. carried over from another counter)
DATA_DIR=./data
VIEWS_START=0

PORT=3000
